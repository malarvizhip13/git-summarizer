# Keep DB_USER/DB_PASSWORD set to the normal application role.
# DB_MIGRATION_USER=postgres
# DB_MIGRATION_PASSWORD=your_postgres_password
GITHUB_TOKEN=your_github_token
DEV_USER_ID=your-generated-uuid
FRONTEND_URL=http://localhost:5173
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
