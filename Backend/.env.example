NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=gitsummarizer
DB_USER=postgres
DB_PASSWORD=your_postgres_password
# Use DATABASE_URL instead of the DB_* values when your host provides a URL.
# DATABASE_URL=
# Set to true when your hosted PostgreSQL provider requires SSL.
DB_SSL=false
# Optional database owner credentials for running migrations.
# Keep DB_USER/DB_PASSWORD set to the normal application role.
# DB_MIGRATION_USER=postgres
# DB_MIGRATION_PASSWORD=your_postgres_password
GITHUB_TOKEN=
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
FRONTEND_URL=http://localhost:5173