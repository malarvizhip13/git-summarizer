{
  "name": "gitsummarizer-backend",
  "version": "1.0.0",
  "description": "Backend API for GitSummarizer",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:create-migration": "node-pg-migrate create",
    "db:migrate": "node scripts/runMigrations.js up",
    "db:rollback": "node scripts/runMigrations.js down"
  },
  "keywords": [
    "github",
    "ai",
    "summarizer",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "node-pg-migrate": "^9.0.0",
    "octokit": "^5.0.5",
    "openai": "^7.47.0",
    "pg": "^8.23.1",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
